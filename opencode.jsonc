{
  "$schema": "https://opencode.ai/config.json",

  // Optional: set a repo-wide default model once you know what is available.
  // "model": "anthropic/claude-sonnet-4-20250514",

  "default_agent": "workflow",
  "instructions": ["./.opencode/WORKFLOW.md"],

  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },

  "agent": {
    "workflow": {
      "description": "Orchestrate feature work through planning, implementation, testing, and review.",
      "mode": "primary",
      "temperature": 0.1,
      "steps": 8,
      "color": "info",
      "prompt": "{file:./.opencode/prompts/workflow.md}",
      "permission": {
        "task": {
          "*": "deny",
          "feature-*": "allow"
        },
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow"
        }
      }
    },

    "feature-planner": {
      "description": "Read-only planner for one small feature slice.",
      "mode": "subagent",
      "temperature": 0.1,
      "steps": 6,
      "color": "accent",
      "prompt": "{file:./.opencode/prompts/feature-planner.md}",
      // Optional model override:
      // "model": "anthropic/claude-sonnet-4-20250514",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow"
        }
      }
    },

    "feature-builder": {
      "description": "Implement the approved slice with the smallest possible diff.",
      "mode": "subagent",
      "temperature": 0.2,
      "steps": 10,
      "color": "primary",
      "prompt": "{file:./.opencode/prompts/feature-builder.md}",
      // Optional model override:
      // "model": "openai/gpt-5",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "npm test*": "allow",
          "pnpm test*": "allow",
          "yarn test*": "allow",
          "bun test*": "allow",
          "pytest *": "allow",
          "uv run pytest*": "allow",
          "go test*": "allow",
          "cargo test*": "allow"
        }
      }
    },

    "feature-tester": {
      "description": "Run the smallest relevant verification commands and summarize results.",
      "mode": "subagent",
      "temperature": 0.1,
      "steps": 6,
      "color": "warning",
      "prompt": "{file:./.opencode/prompts/feature-tester.md}",
      // Optional model override:
      // "model": "anthropic/claude-haiku-4-20250514",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "npm test*": "allow",
          "pnpm test*": "allow",
          "yarn test*": "allow",
          "bun test*": "allow",
          "pytest *": "allow",
          "uv run pytest*": "allow",
          "go test*": "allow",
          "cargo test*": "allow"
        }
      }
    },

    "feature-reviewer": {
      "description": "Critique the diff for correctness, missing tests, and unnecessary complexity.",
      "mode": "subagent",
      "temperature": 0.1,
      "steps": 5,
      "color": "success",
      "prompt": "{file:./.opencode/prompts/feature-reviewer.md}",
      // Optional model override:
      // "model": "google/gemini-2.5-pro",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "ls *": "allow",
          "rg *": "allow"
        }
      }
    }
  }
}
